# Copy this file to .env and fill in the values.
# .env is git-ignored — never commit real secrets.

# Databricks personal access token (or service-principal OAuth token).
# Get one from: Databricks workspace -> User Settings -> Developer -> Access Tokens
DATABRICKS_TOKEN=your-databricks-personal-access-token-here

# Override the Databricks endpoint URL if it changes (optional).
# DATABRICKS_ENDPOINT_URL=https://<your-workspace>.cloud.databricks.com/serving-endpoints/health-food-risk-endpoint/invocations
